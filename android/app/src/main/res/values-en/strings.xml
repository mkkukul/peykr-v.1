    <!-- Detail Screens: Data Backup -->
    <string name="detail_backup_title">Data &amp; Storage Security</string>
    <string name="detail_backup_desc">Local SQLCipher AES-256 encryption and key protection.</string>
    <string name="detail_backup_db_title">Database Encryption</string>
    <string name="detail_backup_db_desc">All contacts and pairing records are encrypted with 256-bit AES via Zetetic SQLCipher. Data cannot be read even with direct filesystem access.</string>
    <string name="detail_backup_wrap_title">Hardware Key Wrapping</string>
    <string name="detail_backup_wrap_desc">The database key is randomly generated and encrypted via AES-256-GCM in Android KeyStore. (Alias: peykr.database.wrap.v1)</string>
    <string name="detail_backup_zero_cloud_title">No Cloud Backup</string>
    <string name="detail_backup_zero_cloud_desc">Due to accountless architecture, your data is not stored in the cloud. If you wipe the device or delete app data, information cannot be recovered.</string>
    <string name="detail_backup_verify_action">Verify Database Integrity</string>

