    <string name="detail_biometric_gate_desc">SecurityGate Architecture:\nAll critical operations (pairing approval, key usage) are guarded by Android Biometric API. Upon successful authentication, a single-use, time-bounded AuthorizationToken is issued.</string>

    <!-- Detail Screens: Location Sharing -->
    <string name="detail_location_title">Location Sharing</string>
    <string name="detail_location_desc">Direct peer-to-peer location synchronization.</string>
    <string name="detail_location_zero_cloud_title">Zero-Cloud Architecture</string>
    <string name="detail_location_zero_cloud_desc">Peykr uses no external location servers, tracking APIs, or cloud infrastructure. Your location is never shared with third parties; it is transmitted encrypted exclusively to your trusted paired peers.</string>
