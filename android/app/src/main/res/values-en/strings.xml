    <string name="detail_about_title">About Peykr</string>
    <string name="detail_about_desc">Privacy-first, accountless, serverless cryptographic communication.</string>
    <string name="detail_about_brand_desc">Peykr is an independent security architecture designed against surveillance and data profiling, requiring no accounts, phone numbers, or servers.</string>
