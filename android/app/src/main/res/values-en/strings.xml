    <string name="detail_about_spec_crypto">Cryptography: Ed25519 Digital Signatures, SHA-256</string>
    <string name="detail_about_spec_storage">Storage: SQLCipher 256-bit AES Encrypted Database</string>
    <string name="detail_about_spec_auth">Authentication: AndroidX Biometric + Monotonic SecurityGate</string>
    <string name="detail_about_spec_transport">Pairing: 4-Step Mutually Signed QR Protocol</string>

