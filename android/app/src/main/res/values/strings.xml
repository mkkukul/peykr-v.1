    <string name="detail_location_toggle_active">Yerel İzin Aktif · P2P Taşıma Katmanı Bekleniyor</string>
    <string name="detail_location_toggle_inactive">Devre Dışı · Konum paylaşılmıyor</string>
    <string name="detail_location_notice_active">Konum tercihi bu cihazda yerel olarak saklanmaktadır. Eşler arası (P2P) aktarım soketi bir sonraki aşamada bağlanacaktır.</string>
    <string name="detail_location_notice_inactive">Konum paylaşımı kapalıdır. Hiçbir konum verisi işlenmez.</string>

    <!-- Detail Screens: Data Backup -->
    <string name="detail_backup_title">Veri ve Depolama Güvenliği</string>
    <string name="detail_backup_desc">Yerel SQLCipher AES-256 şifreleme ve anahtar koruması.</string>
    <string name="detail_backup_db_title">Veritabanı Şifreleme</string>
    <string name="detail_backup_db_desc">Tüm kişi bilgileri ve eşleştirme kayıtları 256-bit AES ile Zetetic SQLCipher tarafından şifrelenir. Dosya sistemine doğrudan erişilse bile veriler okunamaz.</string>
    <string name="detail_backup_wrap_title">Donanım Anahtar Sarmalama</string>
    <string name="detail_backup_wrap_desc">Veritabanı anahtarı rastgele üretilir ve Android KeyStore içinde AES-256-GCM ile şifrelenerek saklanır. (Alias: peykr.database.wrap.v1)</string>
    <string name="detail_backup_zero_cloud_title">Bulut Yedeklemesi Yoktur</string>
    <string name="detail_backup_zero_cloud_desc">Hesapsız mimari gereği verileriniz bulutta tutulmaz. Cihazınızı sıfırlarsanız veya uygulama verilerini silerseniz bilgiler kurtarılamaz.</string>
    <string name="detail_backup_verify_action">Veritabanı Bütünlüğünü Doğrula</string>

